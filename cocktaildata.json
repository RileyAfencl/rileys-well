  {
    "id": "old-fashioned",
    "name": "Old Fashioned",
    "spirit": "bourbon",
    "tags": ["short", "spirit-forward", "sweet"],
    "glass": "rocks",
    "garnish": ["Orange peel", "Cherry"],
    "ingredients": [
      {
        "id": "bourbon",
        "name": "Bourbon",
        "amount": 2.0,
        "unit": "oz"
      },
      {
        "id": "simple-syrup",
        "name": "Simple syrup",
        "amount": 0.5,
        "unit": "oz"
      },
      {
        "id": "angostura-bitters",
        "name": "Angostura bitters",
        "amount": 2.0,
        "unit": "dash"
      }
    ],
    "instructions": [
      "Add bourbon, simple syrup, and angostura bitters to a rocks glass over a large ice cube.",
      "Stir 8-10 times to chill and mix the ingredients.",
      "Squeeze the orange peel, lengthwise, skin facing away from you, over the glass to release the oils.",
      "Run the orange peel around the inside edge of the glass, skin side away from you, and drop it into the glass.",
      "Garnish with a cherry if desired."
    ]
  },
